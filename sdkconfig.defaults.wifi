# Overlay for the Wi-Fi TCP server build. Use together with the normal defaults:
#   idf.py -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.defaults.wifi" set-target esp32
# (the target specific sdkconfig.defaults.<target> files are still picked up automatically, and this
#  overlay is applied after them, so it overrides the "console off" setting of the ESP32 serial build)
CONFIG_AMBE_TRANSPORT_WIFI_TCP=y

# The serial port is now a text console + log output, not a binary link.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y

# (lwIP defaults are fine for one TCP client; sockets: listen + 1 client)

# Keep network processing on core 0; the DV3000 server/codec task is pinned to core 1.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
