# Host-side tests for the setup console (no ESP-IDF).  Usage: make -f Makefile.cli test
CC ?= gcc
M = ../../main
CFLAGS = -std=c11 -Wall -Wextra -O1 -g -fsanitize=address,undefined -I$(M) -D_GNU_SOURCE

test_cli: test_cli.c $(M)/cfg_parse.c $(M)/cli_core.c
	$(CC) $(CFLAGS) $^ -o $@

test: test_cli
	./test_cli

clean:
	rm -f test_cli
.PHONY: test clean
