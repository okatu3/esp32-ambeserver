menu "AMBE3000 compat firmware"

    choice AMBE_TRANSPORT
        prompt "Host link"
        default AMBE_TRANSPORT_USB_CDC if IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32S2
        default AMBE_TRANSPORT_UART
        help
            USB CDC needs a chip with a USB-OTG device peripheral (ESP32-S2/S3) and its native USB connector.
            UART works on every ESP32 (use the board's USB-UART bridge, e.g. UART0 on a classic ESP32 DevKit).

        config AMBE_TRANSPORT_USB_CDC
            bool "Native USB CDC-ACM (ESP32-S2/S3)"
            depends on SOC_USB_OTG_SUPPORTED
        config AMBE_TRANSPORT_UART
            bool "UART (any ESP32, via USB-UART bridge)"
        config AMBE_TRANSPORT_WIFI_TCP
            bool "Wi-Fi TCP server (BlueDV style) + serial setup console"
            depends on SOC_WIFI_SUPPORTED
            help
                The DV3000 protocol is served over TCP. The serial port becomes a text console where the Wi-Fi
                SSID/password and the IP address (DHCP or static) are configured and stored in flash.
                Use sdkconfig.defaults.wifi (it also re-enables the log console).
    endchoice

    config AMBE_UART_NUM
        int "UART number"
        depends on AMBE_TRANSPORT_UART
        default 0
        help
            UART0 is the one wired to the USB-UART bridge on most DevKits. The console must NOT use the same UART
            (the project defaults disable the console on classic ESP32).

    config AMBE_UART_BAUD
        int "UART baud rate (must match AMBETools -s)"
        depends on AMBE_TRANSPORT_UART
        default 460800

    config AMBE_UART_TX_PIN
        int "UART TX pin (-1 = default pin of that UART)"
        depends on AMBE_TRANSPORT_UART
        default -1

    config AMBE_UART_RX_PIN
        int "UART RX pin (-1 = default pin of that UART)"
        depends on AMBE_TRANSPORT_UART
        default -1

    choice AMBE_CLI_PORT
        prompt "Setup console port"
        depends on AMBE_TRANSPORT_WIFI_TCP
        default AMBE_CLI_USB_SERIAL_JTAG if SOC_USB_SERIAL_JTAG_SUPPORTED
        default AMBE_CLI_UART
        help
            Where the setup console (setup / show / status ...) runs. Small ESP32-S3/C3 boards often have only
            the chip's built-in USB connector (USB Serial/JTAG); boards with a USB-UART bridge can use the UART.

        config AMBE_CLI_USB_SERIAL_JTAG
            bool "Built-in USB Serial/JTAG (single-connector ESP32-S3/C3/... boards)"
            depends on SOC_USB_SERIAL_JTAG_SUPPORTED
        config AMBE_CLI_UART
            bool "UART (USB-UART bridge connector)"
    endchoice

    config AMBE_CLI_UART_NUM
        int "Setup console UART number"
        depends on AMBE_CLI_UART
        default 0
        help
            The UART wired to the USB-UART bridge (UART0 on most DevKits). This is the COM port you open on the PC.

    config AMBE_CLI_BAUD
        int "Setup console baud rate"
        depends on AMBE_CLI_UART
        default 115200

    config AMBE_USB_MODE_PIN
        bool "Mode pin: DV3000 over the built-in USB port instead of Wi-Fi"
        depends on AMBE_CLI_USB_SERIAL_JTAG
        default y
        help
            The pin is read once at boot. Open (internal pull-up) = Wi-Fi server + setup console as usual.
            Connected to GND = USB mode: Wi-Fi, the console and all log output are off and the built-in USB
            COM port carries only the DV3000 binary protocol, like a DV3000/ThumbDV USB stick.

    config AMBE_USB_MODE_GPIO
        int "Mode pin GPIO number"
        depends on AMBE_USB_MODE_PIN
        default 4
        help
            Do not use strapping pins (0, 3, 45, 46) or the USB pins (19, 20).

    config AMBE_NOISE_GATE
        bool "Noise gate in front of the AMBE encoder"
        default y
        help
            mbelib-neo has no noise suppression: background noise is encoded as voice and is heard as a
            buzzing/warbling tone between words. The gate follows the noise floor and encodes silence
            unless the input is clearly (+6 dB) above it.

    config AMBE_BOOT_DIAG
        bool "Print boot diagnostics straight to UART0 (ROM console)"
        default n
        help
            Debug aid. Never enable with the UART transport: the text would corrupt the binary protocol stream.

    config AMBE_BENCH_LOG
        bool "Log encode/decode time per frame (to the console, never to the protocol link)"
        default n

    config AMBE_BENCH_INTERVAL
        int "Frames between benchmark log lines"
        depends on AMBE_BENCH_LOG
        default 100

endmenu
