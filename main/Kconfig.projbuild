menu "AMBE3000 compat firmware (USB, plain mbelib-neo)"

    config AMBE_UART_NUM
        int "UART number"
        default 0
        help
            UART0 is the one wired to the USB-UART bridge (CH340/CP2102) on ESP32 DevKits. The ESP-IDF console is
            disabled (sdkconfig.defaults.esp32) so nothing but the DV3000 protocol is sent on it.

    config AMBE_UART_BAUD
        int "UART baud rate"
        default 460800
        help
            460800 is the DV3000 / ThumbDV rate that BlueDV and AMBEServer use.

    config AMBE_UART_TX_PIN
        int "UART TX pin (-1 = default pin of that UART)"
        default -1

    config AMBE_UART_RX_PIN
        int "UART RX pin (-1 = default pin of that UART)"
        default -1

endmenu
